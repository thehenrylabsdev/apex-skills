{
  "compilerOptions": {
    "target": "ES2023",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist-test",
    // contract-validator.ts imports the canonical isRecord from the repository src/.
    "rootDir": "../../.."
  },
  "include": [
    "src/config/**/*.ts",
    "src/contracts/**/*.ts",
    "src/statechart/**/*.ts",
    "tests/**/*.ts"
  ]
}
